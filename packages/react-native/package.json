{
  "name": "react-native-loupe",
  "version": "0.3.0",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.tsx",
  "files": [
    "lib",
    "src",
    "release.js",
    "release.d.ts",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoligama/Loupe.git"
  },
  "keywords": [
    "react-native",
    "debugging",
    "devtools",
    "network",
    "overlay",
    "graphql",
    "curl",
    "json-viewer"
  ],
  "scripts": {
    "build": "bob build && node ../../scripts/bundle-workspace-deps.mjs",
    "prepack": "pnpm --filter @loupe/contract build && pnpm --filter @loupe/core build && bob build && node ../../scripts/bundle-workspace-deps.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@loupe/contract": "workspace:*",
    "@loupe/core": "workspace:*",
    "@testing-library/react-native": "^12.7.2",
    "@types/react": "^18.3.12",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-builder-bob": "^0.32.1",
    "react-test-renderer": "18.3.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./release": {
      "types": "./lib/typescript/release.d.ts",
      "default": "./lib/commonjs/release.js"
    },
    "./package.json": "./package.json"
  }
}
